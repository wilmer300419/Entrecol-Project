# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio.
FLASK_ENV=development
DATABASE_URL=postgresql://usuario:clave@localhost:5432/entrecol
# Genera cada secreto con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_SECRET_KEY=
JWT_EXPIRA_MINUTOS=120
COOKIE_SEGURA=false        # true cuando se sirva por HTTPS (producción)
UPLOAD_MAX_MB=20
